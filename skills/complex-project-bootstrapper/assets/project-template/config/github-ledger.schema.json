{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub task ledger configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enabled", "repository", "state_branch", "accepted_branch", "master_issue", "publishers"],
  "properties": {
    "schema_version": {"const": 1},
    "enabled": {"type": "boolean"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
    "state_branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "accepted_branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "master_issue": {"type": "integer", "minimum": 1},
    "publishers": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\[bot\\])?$", "maxLength": 100}}
  }
}
