{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/henslewm/universal-ai-project-template/config/bootstrap.schema.json",
  "title": "Autonomous Project Bootstrap State",
  "type": "object",
  "required": [
    "schema_version",
    "domain_profile",
    "state",
    "project",
    "architecture",
    "sources",
    "risks",
    "human_gates",
    "unresolved",
    "routing",
    "workflow",
    "domain",
    "configuration",
    "documents",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "domain_profile": {
      "enum": [
        "civil-rights-nc",
        "family-law",
        "software-hardware"
      ]
    },
    "state": {
      "enum": [
        "ACTIVE",
        "ARCHITECTING",
        "ARCHIVED",
        "AWAITING_APPROVAL",
        "BLOCKED",
        "INTAKE",
        "NEEDS_INPUT",
        "NEW",
        "ORIENTING",
        "REVISION_REQUESTED"
      ]
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "objective",
        "definition_of_done",
        "non_goals",
        "constraints"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "definition_of_done": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "summary",
        "boundaries",
        "milestones",
        "dependencies"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": "Each edge is prerequisite -> dependent using exact milestone names; cycles are rejected."
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "routing": {
      "type": "object",
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string"
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string"
        }
      }
    },
    "domain": {
      "type": "object",
      "description": "Minimum orientation fields required for review; domain extensions may strengthen this gate."
    },
    "configuration": {
      "type": "object",
      "description": "Exact config/project.json snapshot, verified against disk for generated projects."
    },
    "documents": {
      "type": "object",
      "description": "SHA-256 bindings for charter, connector and skill plans, and selected domain profile; verified against disk."
    },
    "approval": {
      "type": "object",
      "required": [
        "approved",
        "approved_by",
        "approved_at",
        "architecture_fingerprint"
      ],
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture_fingerprint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "AWAITING_APPROVAL",
              "ACTIVE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "project": {
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "objective": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "definition_of_done": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1
              }
            }
          },
          "architecture": {
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1
              },
              "milestones": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "human_gates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "routing": {
            "properties": {
              "policy": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "workflow": {
            "properties": {
              "policy": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "ACTIVE"
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "approved": {
                "const": true
              },
              "approved_by": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "architecture_fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "approval": {
            "properties": {
              "approved": {
                "const": false
              },
              "approved_by": {
                "type": "null"
              },
              "approved_at": {
                "type": "null"
              },
              "architecture_fingerprint": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain_profile": {
            "const": "software-hardware"
          },
          "state": {
            "enum": [
              "AWAITING_APPROVAL",
              "ACTIVE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "domain": {
            "type": "object",
            "required": [
              "baseline",
              "interfaces",
              "validation_resources"
            ],
            "properties": {
              "baseline": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "interfaces": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "validation_resources": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain_profile": {
            "const": "family-law"
          },
          "state": {
            "enum": [
              "AWAITING_APPROVAL",
              "ACTIVE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "domain": {
            "type": "object",
            "required": [
              "posture",
              "objectives_and_deadlines",
              "evidence"
            ],
            "properties": {
              "posture": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "objectives_and_deadlines": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain_profile": {
            "const": "civil-rights-nc"
          },
          "state": {
            "enum": [
              "AWAITING_APPROVAL",
              "ACTIVE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "domain": {
            "type": "object",
            "required": [
              "posture",
              "defendants_and_theories",
              "evidence_and_remedies"
            ],
            "properties": {
              "posture": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "defendants_and_theories": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence_and_remedies": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  ]
}
