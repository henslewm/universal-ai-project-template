{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/henslewm/universal-ai-project-template/config/bootstrap.schema.json",
  "title": "Autonomous Project Bootstrap State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain_profile", "state", "project", "architecture", "sources", "risks", "routing", "human_gates", "approval"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "domain_profile": {"enum": ["software-hardware", "family-law", "civil-rights-nc"]},
    "state": {"enum": ["NEW", "ORIENTING", "INTAKE", "ARCHITECTING", "AWAITING_APPROVAL", "ACTIVE", "NEEDS_INPUT", "BLOCKED", "REVISION_REQUESTED", "ARCHIVED"]},
    "project": {
      "type": "object",
      "required": ["name", "objective", "definition_of_done", "non_goals", "constraints"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "architecture": {
      "type": "object",
      "required": ["summary", "boundaries", "milestones", "dependencies"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "milestones": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "routing": {
      "type": "object",
      "required": ["policy"],
      "properties": {"policy": {"type": "string", "minLength": 1}}
    },
    "human_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "domain": {"type": "object", "description": "Domain-profile extension data. Detailed branch-specific schemas are completed in domain issues #9/#10/#11."},
    "approval": {
      "type": "object",
      "required": ["approved", "approved_by", "approved_at", "architecture_fingerprint"],
      "properties": {
        "approved": {"type": "boolean"},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "architecture_fingerprint": {"type": ["string", "null"]}
      }
    }
  }
}
